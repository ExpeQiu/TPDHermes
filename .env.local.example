# 可选：前端 API 根地址。本地开发留空即可（浏览器经 Next /api/v1 代理到 :8000，无跨域）
# NEXT_PUBLIC_API_URL=http://localhost:8000

# 工坊 Agent 模式：capture 未命中时默认直连降级（与 chat 单技能白名单一致）
# WORKSHOP_AGENT_STRICT=true 关闭降级，仅接受 MCP tool capture
# WORKSHOP_AGENT_FALLBACK_DIRECT=false 也可关闭降级

# 可选：前端直连外部聊天服务（默认未启用，通常由后端 /api/v1/chat/completions 代理）
# NEXT_PUBLIC_CHAT_API_URL=http://localhost:8642/v1/chat/completions
# NEXT_PUBLIC_CHAT_API_KEY=YOUR_KEY

# Obsidian Vault 根目录（知识库 Markdown 内嵌图片经 /api/v1/kb/vault-asset 代理）
# OBSIDIAN_VAULT_ROOT=/path/to/your/4.Knowledge

# 头脑风暴（multi-agent 圆桌外挂）
# MULTI_AGENT_URL=http://127.0.0.1:8765
# MULTI_AGENT_ROOT=/path/to/TPD-multi-agent
# MULTI_AGENT_MOCK_MODE=true
# MULTI_AGENT_HTTP_TIMEOUT=300
