# 堡垒机构建：基于 Dockerfile.alicloud，Playwright 走官方 CDN（npmmirror 缺包会 404）
FROM docker.m.daocloud.io/library/debian:13.4

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
      sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; \
    fi

ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential curl xz-utils python3 ripgrep ffmpeg gcc python3-dev libffi-dev procps git openssh-client docker-cli tini gosu ca-certificates && \
    rm -rf /var/lib/apt/lists/*

ARG NODE_VERSION=22.14.0
RUN set -eux; \
    curl -fsSL "https://npmmirror.com/mirrors/node/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.txz; \
    tar -xJf /tmp/node.txz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.txz; \
    node -v && npm -v

RUN useradd -u 10000 -m -d /opt/data hermes
RUN ln -sf /usr/sbin/gosu /usr/local/bin/gosu && chmod +x /usr/local/bin/gosu

ARG UV_VERSION=0.11.6
ENV UV_INSTALL_DIR=/usr/local
ENV UV_CACHE_DIR=/root/.cache/uv
RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | sh \
    && ln -sf /usr/local/uv /usr/bin/uv \
    && ln -sf /usr/local/uvx /usr/bin/uvx \
    && uv --version
ENV PATH="/usr/local:/usr/local/bin:${PATH}"

RUN npm config set registry https://registry.npmmirror.com/

WORKDIR /opt/hermes

COPY package.json package-lock.json ./
COPY web/package.json web/package-lock.json web/
COPY ui-tui/package.json ui-tui/package-lock.json ui-tui/
COPY ui-tui/packages/hermes-ink/ ui-tui/packages/hermes-ink/

ENV npm_config_install_links=false

RUN --mount=type=cache,target=/root/.npm \
    npm install --prefer-offline --no-audit

# 官方 CDN 安装 Playwright chromium headless shell
RUN --mount=type=cache,target=/root/.npm \
    --mount=type=cache,target=/root/.cache/ms-playwright \
    npx playwright install --with-deps chromium --only-shell

RUN --mount=type=cache,target=/root/.npm \
    sh -c "cd web && npm install --prefer-offline --no-audit"

RUN --mount=type=cache,target=/root/.npm \
    sh -c "cd ui-tui && npm install --prefer-offline --no-audit"

COPY pyproject.toml uv.lock ./
RUN touch ./README.md
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --extra all

COPY --chown=hermes:hermes . .

RUN --mount=type=cache,target=/root/.npm \
    sh -c "cd web && npm run build && cd ../ui-tui && npm run build"

USER root
RUN chmod -R a+rX /opt/hermes && \
    chown -R hermes:hermes /opt/hermes/.venv /opt/hermes/ui-tui /opt/hermes/node_modules /opt/hermes/web

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-cache-dir --no-deps -e "."

ENV HERMES_WEB_DIST=/opt/hermes/hermes_cli/web_dist
ENV HERMES_HOME=/opt/data
ENV PATH="/opt/data/.local/bin:${PATH}"
VOLUME [ "/opt/data" ]
ENTRYPOINT [ "/usr/bin/tini", "-g", "--", "/opt/hermes/docker/entrypoint.sh" ]
