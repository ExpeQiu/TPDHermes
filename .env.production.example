# Copy this file to `.env` before running:
#   cp .env.production.example .env

# Public access entry
PUBLIC_DOMAIN=47.113.225.93:8033
PUBLIC_ORIGIN=http://47.113.225.93:8033

# Frontend build-time variables
NEXT_PUBLIC_API_URL=http://47.113.225.93:8033
NEXT_PUBLIC_USE_MOCK_KB=

# Backend runtime variables
DATABASE_URL=sqlite+aiosqlite:////app/data/tphermes.db
CORS_ALLOWED_ORIGINS=http://47.113.225.93:8033
CHROMA_HOST=http://your-chroma-host:8001
HERMES_CHAT_API_URL=http://hermes-agent:8642/v1/chat/completions
HERMES_CHAT_API_KEY=change-me
HERMES_CHAT_MODEL=hermes-agent

# Hermes-agent runtime variables
# Set this to the image you actually publish or replace the service with a local build context.
HERMES_AGENT_IMAGE=ghcr.io/your-org/hermes-agent:latest
# Keep this key aligned with HERMES_CHAT_API_KEY unless Hermes-agent uses a different auth chain.
HERMES_AGENT_API_SERVER_KEY=change-me
# Recommended MiniMax China provider settings for Hermes-agent.
# Hermes-agent reads MINIMAX_CN_API_KEY directly; do not invent a custom alias.
MINIMAX_CN_API_KEY=
MINIMAX_CN_BASE_URL=https://api.minimaxi.com/anthropic
# Tavily Remote MCP source for `tphermes-mcp`.
# `hermes-agent` no longer needs to talk to Tavily directly; it consumes Tavily
# as MCP tools exposed by `tphermes-mcp`.
TAVILY_API_KEY=
TAVILY_REMOTE_MCP_URL=https://mcp.tavily.com/mcp/
# Optional: keep the runtime default model aligned with your provider choice.
# Hermes-agent persists its own config under /opt/data/config.yaml; set provider=minimax-cn
# and model=MiniMax-M2.7-highspeed there for a clean rebuild story.

# Optional image tags if you want deterministic deploys
TPDHERMES_FRONTEND_IMAGE=tphermes-frontend:prod
TPDHERMES_BACKEND_IMAGE=tphermes-backend:prod

# TPDHermes MCP service for hermes-agent tool access
TPDHERMES_MCP_HOST=0.0.0.0
TPDHERMES_MCP_PORT=8801
TPDHERMES_MCP_PATH=/mcp
TPDHERMES_MCP_TRANSPORT=streamable-http
TPDHERMES_MCP_LOG_LEVEL=info
TPDHERMES_MCP_URL=http://tphermes-mcp:8801/mcp

# Optional integrations
FEISHU_APP_ID=
FEISHU_APP_SECRET=
